__pycache__/
*.pyc
api_output/

# data/ is run.py's DATA_DIR: data/raw holds the doorlist exports uploaded
# through Railway, which carry names, emails and phone numbers. Keep the whole
# tree ignored and re-admit only the merged CSVs at the top level - those are
# the aggregate-only 11-column files an incremental fetch resumes from, and
# they contain no contact fields. Never relax this to a bare `!data/` or the
# raw uploads become committable. (See incident 2026-04-21_PII_EXPOSURE.)
data/*
!data/*_merged.csv
!data/*_state.json

# Local post-processing previews. These must not be tracked: a root-level
# *.html matches both deploy-pages.yml's paths filter and the daily job's
# `git add -- '*.html'`, so a committed preview would publish to Pages and be
# re-committed as though it were a dashboard.
*_preview.html

# Build sidecar: written by build_dashboard.py, consumed by postprocess_html.py
# in the same build. Never needs committing.
*.html.suivi.json

# Temp scripts the browser-driven checks write to the repo ROOT and unlink when
# they finish. They are invisible almost always - and were swept into the
# CUTOVER commit by a `git add -A` that ran while the suite was still going, so
# a file that exists for ~90 seconds landed in the one commit that most needed
# to contain only what it claims.
#
# `.cutover-new` is the same shape from the other direction: cutover.py stages
# every write to a sibling and renames only once all of them exist, so a crash
# mid-stage leaves them behind.
.check_b1.js
.check_v2_gate.js
.check_v2_behaviour.js
*.cutover-new
